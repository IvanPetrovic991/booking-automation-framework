# Copy to .env and adjust as needed.
# A git-ignored .env.local (same keys) overrides .env for developer-specific values.

# Target environment
BASE_URL=https://www.booking.com

# Browser
HEADLESS=true

# Timeouts (ms)
DEFAULT_TEST_TIMEOUT=150000
EXPECT_TIMEOUT=15000
HEALER_TIMEOUT=20000
# How long the primary selector keeps exclusive right to match before the
# healer may promote a fallback (prevents false heals on slow renders)
HEALER_GRACE_MS=2000

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Abort third-party analytics/tracker requests (faster, more stable runs)
BLOCK_TRACKERS=true
